# Copy this file to .env and fill in your values. Never commit .env.

# AI provider: "gemini" (FREE via Google AI Studio, no billing) or "anthropic" (paid key).
AI_PROVIDER=gemini

# Google AI Studio key — free at https://aistudio.google.com/apikey (no billing needed).
GEMINI_API_KEY=

# Gemini model for generation (must be a model covered by the free tier).
GEMINI_MODEL=gemini-3.8-flash
# Used automatically if the primary model is overloaded.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Anthropic key — only needed when AI_PROVIDER=anthropic. Get one at
# https://console.anthropic.com (requires billing enabled).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used when AI_PROVIDER=anthropic (check docs.anthropic.com for current IDs).
ANTHROPIC_MODEL=claude-sonnet-4-5

# Max tokens per generation (bigger pages need more)
MAX_TOKENS=12000

# Credits given to a brand-new user
FREE_CREDITS=25

# Credits charged for one generation.
# 100 credits per $12.99 one-time purchase = ~10 builds at 10/build.
CREDITS_PER_BUILD=10

# Comma-separated list of allowed frontend origins, e.g. https://muse.ai
# Leave empty for local dev (allows all). SET THIS IN PRODUCTION.
CORS_ORIGIN=

# Max time to wait for the AI provider per generation (ms)
AI_TIMEOUT_MS=120000

# Domain for free customer subdomains (e.g. mysites.com).
# Requires a wildcard DNS record: *.mysites.com -> your server.
# Leave empty to disable; published sites still work via /s/{id}/ URLs.
SITES_DOMAIN=

# Port the server listens on
PORT=3000
